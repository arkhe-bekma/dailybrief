.venv/
__pycache__/
*.pyc
.env
.DS_Store
# SSH / private keys — never commit
*.pem
# Local SQLite DB — created at runtime, never commit
backend/data/
*.db
*.db-shm
*.db-wal

# Editor / agent scratch
.claude/
# Pre-git manual snapshots that used to live on the server.
checkpoints/
# Stray on-server edit backups — history belongs in git now.
*.bak
*.bak.*
._*

# Archived article corpus — written by backend/agent/archivist.py.
# Operational data: grows without bound, differs per deployment, and
# would bloat the repo. The folder + its README are tracked so the
# layout is documented; the .ndjson files are not.
archive/*
!archive/README.md

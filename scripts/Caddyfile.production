# Live Caddy config for dailybrief.fun.
#
# This is the file that actually runs on the Lightsail box at
# /etc/caddy/Caddyfile. It lives in the repo so the edge config is
# reviewable and restorable instead of existing only on the server.
#
# Apply with:  sudo cp scripts/Caddyfile.production /etc/caddy/Caddyfile \
#              && sudo systemctl reload caddy

{
    auto_https disable_redirects
}

dailybrief.fun, www.dailybrief.fun {
    encode gzip

    # ── /pro — CLOSED ────────────────────────────────────────────
    # DailyBrief Pro is off for now. Both /pro and /pro/* redirect to
    # the main app (302, not 301 — a permanent redirect would get
    # cached by browsers and make re-opening /pro painful).
    #
    # To re-open: delete the two lines below and uncomment the block
    # underneath. The static build is still on disk at
    # /srv/dailybrief_pro and in the repo at frontend_pro/.
    @pro path /pro /pro/*
    redir @pro / 302

    # @pro_root path /pro
    # redir @pro_root /pro/ permanent
    #
    # handle_path /pro/* {
    #     root * /srv/dailybrief_pro
    #     try_files {path} /index.html
    #     file_server
    # }

    # ── Static assets served straight off disk ───────────────────
    # These used to be proxied to uvicorn's StaticFiles mount, which
    # meant every page load pushed ~170 KB of JS + CSS through Python on
    # a single-worker process with 416 MB of RAM. Caddy serves them
    # without waking the app at all.
    #
    # Needs `chmod o+x /home/ubuntu` so caddy can traverse to the
    # directory (execute-only: it permits traversal, not listing).
    #
    # Every asset is versioned in the HTML (?v=NN), so a long immutable
    # cache is safe — a change ships a new query string, not a new file.
    handle_path /static/* {
        root * /home/ubuntu/dailybrief/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    reverse_proxy 127.0.0.1:8000
}

# Backup URL — works without the custom domain.
35-90-60-42.sslip.io {
    encode gzip
    reverse_proxy 127.0.0.1:8000
}

# Plain HTTP via IP (needs Chrome HTTPS-Only mode off).
:80 {
    encode gzip
    reverse_proxy 127.0.0.1:8000
}

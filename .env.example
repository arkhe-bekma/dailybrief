# ── Where uvicorn binds. Caddy proxies 443→127.0.0.1:PORT on the server.
PORT=8000
HOST=0.0.0.0

# ── Optional. Without it, the curator falls back to keyword scoring.
ANTHROPIC_API_KEY=

# ── Optional: real whale-alert data (https://whale-alert.io/). Empty = mock.
WHALE_ALERT_API_KEY=

# ── Optional: real YouTube Data API. Empty = channel RSS feeds.
YOUTUBE_API_KEY=

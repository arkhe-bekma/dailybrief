# Required only if you want Claude-based curation. Without it, the app falls
# back to a heuristic scorer (keyword match against your interest profile).
ANTHROPIC_API_KEY=

# Optional: Whale Alert API key (https://whale-alert.io/) once you switch on
# real whale data. Leave blank for mocked whales.
WHALE_ALERT_API_KEY=

# Optional: YouTube Data API key once you switch on real channel polling.
YOUTUBE_API_KEY=

# ── Where uvicorn binds. Caddy proxies 443→127.0.0.1:PORT on the server.
PORT=8000
HOST=0.0.0.0

# ── Optional. Without it, the curator falls back to keyword scoring.
ANTHROPIC_API_KEY=

# ── Optional but recommended. Powers the in-app "translate" button on
#    the reader modal. Free-tier Gemini 2.5 Flash from Google AI Studio
#    is plenty for personal use (15 RPM / 1500 RPD as of 2025). Without
#    it, the translate button returns "translation unavailable".
GEMINI_API_KEY=

# ── Optional: real whale-alert data (https://whale-alert.io/). Empty = mock.
WHALE_ALERT_API_KEY=

# ── Optional: real YouTube Data API. Empty = channel RSS feeds.
YOUTUBE_API_KEY=
